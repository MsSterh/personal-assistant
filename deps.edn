{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.11.4"}
        hato/hato          {:mvn/version "0.9.0"}
        cheshire/cheshire  {:mvn/version "5.12.0"}
        aero/aero          {:mvn/version "1.1.6"}
        clj-commons/clj-yaml {:mvn/version "0.7.107"}
        org.jsoup/jsoup    {:mvn/version "1.18.1"}}

 :aliases
 {:test    {:extra-paths ["test"]
             :extra-deps  {io.github.cognitect-labs/test-runner
                           {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
             :exec-fn     cognitect.test-runner.api/test
             :exec-args   {:dirs ["test"]}}

  :lint    {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
             :main-opts  ["-m" "clj-kondo.main" "--lint" "src" "test"]}

  :fmt     {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
             :main-opts  ["-m" "cljfmt.main" "check" "src" "test"]}

  :fmt-fix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
             :main-opts  ["-m" "cljfmt.main" "fix" "src" "test"]}

  :repl    {:main-opts ["-m" "personal-assistant.repl"]}}}
